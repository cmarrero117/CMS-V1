# Copy this file to .env.local and fill in your values
MONGODB_URI=your_mongodb_connection_string_here
NEXTAUTH_SECRET=generate_a_random_secret_here
NEXTAUTH_URL=http://localhost:3000

# Optional — enables the "Upload" button on image fields (logo, hero
# image, team photos). Without these, the URL-paste fields still work
# fine; uploads just aren't available.
# 1. Create a free account at cloudinary.com
# 2. Cloud Name is on your dashboard homepage
# 3. Settings -> Upload -> Upload presets -> Add upload preset ->
#    set Signing Mode to "Unsigned" -> save, then use its name below
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name_here
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset_name_here
